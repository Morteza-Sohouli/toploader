# MYSQL_ROOT_PASSWORD=rootpassword
# MYSQL_DATABASE=databaseName
# MYSQL_USER=userName
# MYSQL_PASSWORD=userpassword

# App URL (used by API CORS). Use https when behind SSL proxy.
# UPLOAD_URL=https://localhost

# Let's Encrypt – comma-separated list of all domains for a single multi-domain certificate
# SSL_DOMAINS=domain1.com,domain2.com,domain3.com
# SSL_EMAIL=you@example.com

# Host paths for each domain's WP uploads directory.
# Each path maps to a container mount defined in docker-compose.yml.
# The domain-to-container-path mapping is in config/wp-domains.json.
# WP_UPLOADS_PATH_1=/host/path/to/domain1/uploads
# WP_UPLOADS_PATH_2=/host/path/to/domain2/uploads
# WP_UPLOADS_PATH_3=/host/path/to/domain3/uploads
# Optional: defaults to WP_UPLOADS_PATH_3 when both domains share storage.
# WP_UPLOADS_PATH_4=/host/path/to/domain4/uploads
# Required: use at least 32 random characters. Existing signed links become
# invalid if this value changes.
# SECURE_LINK_SECRET=replace-with-a-cryptographically-random-secret

# Never enable detailed errors in production.
# APP_DEBUG=false
