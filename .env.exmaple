MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=databaseName
MYSQL_USER=userName
MYSQL_PASSWORD=userpassword

# App URL (used by API CORS). Use https when behind SSL proxy.
UPLOAD_URL=http://localhost:8080
# UPLOAD_URL=https://localhost

# API base URL for the Vue client. Use https and /api when behind SSL proxy.
# VITE_API_BASE_URL=http://localhost:3000
# VITE_API_BASE_URL=https://localhost/api

# Let's Encrypt (Docker certbot-init + certbot-renew cron)
# SSL_DOMAIN=yourdomain.com
# SSL_EMAIL=you@example.com